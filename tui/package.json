    "stories": "node preview.mjs"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
