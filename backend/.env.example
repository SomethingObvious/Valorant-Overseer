# ─── Valorant Overseer environment ─────────────────────────────────────────────
# Copy this file to ".env" and fill in what you need. Everything has a default,
# so an empty file works.

# An official Riot API key, from https://developer.riotgames.com. A personal key
# is enough for account-v1, which the app uses to look up Riot IDs.
RIOT_API_KEY=

# Your PUUID comes from the running VALORANT client, so there is nothing to set
# here for the live board.

# Shard:  na | eu | ap | kr | latam | br
RIOT_REGION=na

# Data source:  auto | demo
#   auto   the VALORANT client on this PC, and a waiting screen when it isn't open
#   demo   sample players, for looking at the app without the game
DATA_SOURCE=auto

# Loopback port for the local WebSocket bridge (binds 127.0.0.1 only).
WS_PORT=7878
